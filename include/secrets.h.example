#pragma once
// =============================================================================
// secrets.h.example — template de credenciales
//
// Uso:
//   cp include/secrets.h.example include/secrets.h
//   # Editar include/secrets.h con los valores reales
//
// IMPORTANTE: include/secrets.h está en .gitignore y NUNCA debe commitearse.
//   Solo este archivo (secrets.h.example) es versionado — sin credenciales reales.
//
// Si algún campo queda vacío (""):
//   - WIFI_SSID vacío     → WiFi completamente desactivado. El Tamagochi
//                           sigue funcionando offline sin intentar conectar.
//   - OTA_PASSWORD vacío  → OTA deshabilitada (NO recomendado en producción).
//   - WEB_AUTH_PASSWORD   → Auth HTTP deshabilitada (NO recomendado).
// =============================================================================

// WiFi STA — credenciales de la red doméstica
// Si WIFI_SSID es "" (vacío), WifiManager no intenta conectar.
#define WIFI_SSID          ""
#define WIFI_PASSWORD      ""

// OTA — hostname mDNS y password de actualización inalámbrica
// El dispositivo será accesible como <OTA_HOSTNAME>.local en la LAN.
// Password vacío deshabilita OTA (NO recomendado — sin OTA hay que reflashear físicamente).
#define OTA_HOSTNAME       "tamagotchi"   // sin .local — mDNS lo añade
#define OTA_PASSWORD       ""             // cambiar a una password segura

// HTTP Basic Auth para /api/v1/* (WebUI Fase 3)
// Password vacío deshabilita la auth (NO recomendado si el dispositivo es accesible).
#define WEB_AUTH_USER      "admin"
#define WEB_AUTH_PASSWORD  ""             // cambiar a una password segura
